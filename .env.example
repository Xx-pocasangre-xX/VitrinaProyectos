# -----------------------------------------------------------------
# Variables de entorno - Vitrina Dev
# -----------------------------------------------------------------
# Copia este archivo como ".env.local" y reemplaza los valores con
# los datos reales de tu proyecto de Supabase.
#
# Dónde encontrarlos: entra a tu proyecto en https://supabase.com/dashboard
# -> Project Settings -> API.
#
# Ambas variables llevan el prefijo NEXT_PUBLIC_ porque se usan para leer
# datos públicos (solo lectura, protegidos por políticas RLS) tanto desde
# Server Components como, potencialmente, desde el navegador. La clave
# "anon" NUNCA debe confundirse con la "service_role", que sí es secreta
# y jamás debe exponerse en el frontend.
# -----------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
